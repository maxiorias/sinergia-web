---
// Casa inteligente en 3D (three.js) + panel de control que la maneja.
// La geometría se arma por código: no hay modelos que descargar.
import Icono from './Icono.astro';

const controles = [
  { id: 'luces', nombre: 'Luces', icono: 'luz', encendido: true },
  { id: 'persianas', nombre: 'Persianas', icono: 'persiana', encendido: false },
  { id: 'camaras', nombre: 'Cámaras', icono: 'camara', encendido: true },
  { id: 'alarma', nombre: 'Alarma', icono: 'escudo', encendido: false },
];
---

<div class="relative">
  <div id="casa3d" class="relative aspect-[4/3.2] w-full overflow-hidden rounded-[2rem] border border-borde bg-[radial-gradient(circle_at_50%_35%,#14303a,transparent_70%)]">
    <!-- Respaldo si no hay WebGL o mientras carga -->
    <div id="casa3d-respaldo" class="absolute inset-0 grid place-items-center text-niebla">
      <Icono nombre="casa" class="size-24 opacity-40" />
    </div>
    <span class="absolute top-4 left-4 flex items-center gap-2 rounded-full bg-noche/70 px-3 py-1.5 text-xs font-medium text-niebla ring-1 ring-borde backdrop-blur">
      <span class="pulso size-2 rounded-full bg-acento"></span> Sistema conectado
    </span>
  </div>

  <!-- Panel de control: maneja la escena -->
  <div class="relative z-10 mx-auto -mt-8 grid w-[92%] sm:-mt-12 grid-cols-4 gap-2 rounded-3xl border border-borde bg-panel/90 p-2.5 shadow-2xl backdrop-blur-md sm:gap-3 sm:p-3">
    {controles.map((c) => (
      <button
        type="button"
        data-control={c.id}
        aria-pressed={c.encendido ? 'true' : 'false'}
        class="group flex flex-col items-center gap-1.5 rounded-2xl px-1 py-3 text-niebla transition hover:bg-white/5 aria-pressed:bg-acento/10 aria-pressed:text-acento"
      >
        <Icono nombre={c.icono} class="size-6" />
        <span class="text-[11px] font-semibold sm:text-xs">{c.nombre}</span>
        <span class="h-1 w-6 rounded-full bg-borde transition group-aria-pressed:bg-acento"></span>
      </button>
    ))}
  </div>
</div>

<script>
  import * as THREE from 'three';

  const contenedor = document.getElementById('casa3d')!;
  const respaldo = document.getElementById('casa3d-respaldo')!;
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-control]');
  const reducirMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const estado: Record<string, boolean> = {};
  botones.forEach((b) => (estado[b.dataset.control!] = b.getAttribute('aria-pressed') === 'true'));

  function soportaWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (soportaWebGL()) iniciar();

  function iniciar() {
    const ACENTO = 0x2ee6c5;
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    contenedor.prepend(renderer.domElement);
    renderer.domElement.classList.add('absolute', 'inset-0', 'size-full');
    respaldo.remove();

    const escena = new THREE.Scene();
    const camara = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
    camara.position.set(9, 6.5, 10);
    camara.lookAt(0, 1, 0);

    escena.add(new THREE.AmbientLight(0x8fb3c9, 0.55));
    const sol = new THREE.DirectionalLight(0xffffff, 1.1);
    sol.position.set(5, 10, 6);
    escena.add(sol);

    const mundo = new THREE.Group();
    escena.add(mundo);

    // Plataforma con grilla
    const base = new THREE.Mesh(
      new THREE.CylinderGeometry(6, 6, 0.25, 64),
      new THREE.MeshStandardMaterial({ color: 0x0f1820, roughness: 0.9 })
    );
    base.position.y = -0.125;
    mundo.add(base);
    const grilla = new THREE.GridHelper(11, 22, ACENTO, 0x1f2b37);
    (grilla.material as THREE.Material).transparent = true;
    (grilla.material as THREE.Material).opacity = 0.35;
    grilla.position.y = 0.01;
    mundo.add(grilla);

    // Casa moderna: dos volúmenes con bordes resaltados
    const materialMuro = new THREE.MeshStandardMaterial({ color: 0x1b2631, roughness: 0.7, metalness: 0.1 });
    const materialBorde = new THREE.LineBasicMaterial({ color: ACENTO, transparent: true, opacity: 0.55 });
    function volumen(ancho: number, alto: number, prof: number, x: number, y: number, z: number) {
      const geo = new THREE.BoxGeometry(ancho, alto, prof);
      const m = new THREE.Mesh(geo, materialMuro);
      m.position.set(x, y + alto / 2, z);
      m.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo), materialBorde));
      mundo.add(m);
      return m;
    }
    volumen(4.2, 2.2, 3, -0.6, 0, 0);
    volumen(2.6, 1.7, 2.6, 0.9, 2.2, -0.2);
    volumen(1.8, 1.4, 2, 2.6, 0, 0.5);

    // Ventanas que se encienden y persianas que bajan
    const materialVentana = new THREE.MeshStandardMaterial({ color: 0x0b1118, emissive: 0xffc46b, emissiveIntensity: 0 });
    const materialPersiana = new THREE.MeshStandardMaterial({ color: 0x2b3946, roughness: 0.6 });
    const persianas: THREE.Mesh[] = [];
    function ventana(ancho: number, alto: number, x: number, y: number, z: number) {
      const v = new THREE.Mesh(new THREE.PlaneGeometry(ancho, alto), materialVentana);
      v.position.set(x, y, z);
      mundo.add(v);
      const p = new THREE.Mesh(new THREE.BoxGeometry(ancho, alto, 0.04), materialPersiana);
      p.geometry.translate(0, -alto / 2, 0); // crece desde arriba hacia abajo
      p.position.set(x, y + alto / 2, z + 0.03);
      p.scale.y = 0.02;
      mundo.add(p);
      persianas.push(p);
    }
    ventana(1.4, 1.1, -1.6, 1.1, 1.51);
    ventana(1.4, 1.1, 0.3, 1.1, 1.51);
    ventana(1.6, 0.9, 0.9, 3.05, 1.11);
    ventana(1, 0.8, 2.6, 0.8, 1.51);
    const luzInterior = new THREE.PointLight(0xffc46b, 0, 7);
    luzInterior.position.set(-0.4, 1.4, 2.6);
    mundo.add(luzInterior);

    // Cámara de seguridad con cono de visión
    const camaraSeg = new THREE.Group();
    camaraSeg.position.set(-2.6, 2.05, 1.45);
    mundo.add(camaraSeg);
    camaraSeg.add(new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.2, 0.45), new THREE.MeshStandardMaterial({ color: 0xe8eef4 })));
    const cono = new THREE.Mesh(
      new THREE.ConeGeometry(1.3, 3.2, 32, 1, true),
      new THREE.MeshBasicMaterial({ color: ACENTO, transparent: true, opacity: 0.16, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending })
    );
    cono.geometry.translate(0, -1.6, 0);
    cono.rotation.x = -Math.PI / 2.6;
    const pivote = new THREE.Group();
    pivote.add(cono);
    camaraSeg.add(pivote);

    // Anillos de alarma en el piso
    const anillos: THREE.Mesh[] = [];
    for (let i = 0; i < 3; i++) {
      const a = new THREE.Mesh(
        new THREE.RingGeometry(0.95, 1, 64),
        new THREE.MeshBasicMaterial({ color: 0xff4d6d, transparent: true, opacity: 0, side: THREE.DoubleSide, depthWrite: false })
      );
      a.rotation.x = -Math.PI / 2;
      a.position.y = 0.03;
      mundo.add(a);
      anillos.push(a);
    }
    const luzAlarma = new THREE.PointLight(0xff4d6d, 0, 10);
    luzAlarma.position.set(0, 4, 0);
    mundo.add(luzAlarma);

    // Señal WiFi sobre el techo
    const ondas: THREE.Mesh[] = [];
    for (let i = 0; i < 3; i++) {
      const o = new THREE.Mesh(
        new THREE.TorusGeometry(0.35 + i * 0.3, 0.03, 8, 48, Math.PI / 1.6),
        new THREE.MeshBasicMaterial({ color: 0x4da3ff, transparent: true, opacity: 0.8 })
      );
      o.position.set(0.9, 4.25, -0.2);
      o.rotation.z = Math.PI / 2 - Math.PI / 3.2;
      mundo.add(o);
      ondas.push(o);
    }

    // Interacción: el panel cambia el estado
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.control!;
        estado[id] = !estado[id];
        b.setAttribute('aria-pressed', String(estado[id]));
        if (reducirMovimiento) dibujar(performance.now());
      })
    );

    // Parallax con el mouse
    let mx = 0, my = 0;
    contenedor.addEventListener('pointermove', (e) => {
      const r = contenedor.getBoundingClientRect();
      mx = (e.clientX - r.left) / r.width - 0.5;
      my = (e.clientY - r.top) / r.height - 0.5;
    });

    function ajustarTamano() {
      const { width, height } = contenedor.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camara.aspect = width / height;
      // En pantallas angostas alejamos la cámara para que entre toda la casa
      const distancia = width < 520 ? 1.35 : 1;
      camara.position.set(9 * distancia, 6.5 * distancia, 10 * distancia);
      camara.lookAt(0, 1.2, 0);
      camara.updateProjectionMatrix();
      if (reducirMovimiento) dibujar(performance.now());
    }

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    function dibujar(t: number) {
      const s = t / 1000;
      const k = reducirMovimiento ? 1 : 0.08;

      mundo.rotation.y = reducirMovimiento ? -0.35 : lerp(mundo.rotation.y, -0.35 + Math.sin(s * 0.25) * 0.35 + mx * 0.5, 0.05);
      mundo.rotation.x = reducirMovimiento ? 0 : lerp(mundo.rotation.x, my * 0.12, 0.05);

      materialVentana.emissiveIntensity = lerp(materialVentana.emissiveIntensity, estado.luces ? 1.4 : 0.03, k);
      luzInterior.intensity = lerp(luzInterior.intensity, estado.luces ? 6 : 0, k);
      persianas.forEach((p) => (p.scale.y = lerp(p.scale.y, estado.persianas ? 1 : 0.02, k)));

      (cono.material as THREE.MeshBasicMaterial).opacity = lerp((cono.material as THREE.MeshBasicMaterial).opacity, estado.camaras ? 0.16 : 0, k);
      if (estado.camaras && !reducirMovimiento) pivote.rotation.y = Math.sin(s * 0.8) * 0.7 - 0.2;

      anillos.forEach((a, i) => {
        const fase = ((s * 0.6 + i / 3) % 1);
        const m = a.material as THREE.MeshBasicMaterial;
        if (estado.alarma) {
          const r = reducirMovimiento ? 2 + i * 1.3 : 0.5 + fase * 5;
          a.scale.setScalar(r);
          m.opacity = reducirMovimiento ? 0.4 : (1 - fase) * 0.7;
        } else m.opacity = lerp(m.opacity, 0, 0.1);
      });
      luzAlarma.intensity = estado.alarma ? (reducirMovimiento ? 4 : 3 + Math.sin(s * 6) * 3) : lerp(luzAlarma.intensity, 0, 0.1);

      ondas.forEach((o, i) => {
        (o.material as THREE.MeshBasicMaterial).opacity = reducirMovimiento ? 0.7 : 0.25 + 0.75 * Math.max(0, Math.sin(s * 3 - i * 0.9));
      });

      renderer.render(escena, camara);
    }

    new ResizeObserver(ajustarTamano).observe(contenedor);
    ajustarTamano();

    // Solo anima cuando está en pantalla
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(contenedor);
    if (reducirMovimiento) {
      dibujar(performance.now());
    } else {
      renderer.setAnimationLoop((t) => visible && dibujar(t));
    }
  }
</script>
