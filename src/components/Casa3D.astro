---
// Casa inteligente en 3D (three.js, ver src/scripts/casa3d.ts) + panel que la maneja.
import Icono from './Icono.astro';

const controles = [
  { id: 'luces', nombre: 'Luces', icono: 'luz', encendido: true },
  { id: 'persianas', nombre: 'Persianas', icono: 'persiana', encendido: false },
  { id: 'camaras', nombre: 'Cámaras IA', icono: 'camara', encendido: true },
  { id: 'alarma', nombre: 'Alarma', icono: 'escudo', encendido: false },
];

// Escenas de domótica: un toque cambia varias cosas a la vez
const escenas = [
  { id: 'llegada', nombre: 'Llegada' },
  { id: 'noche', nombre: 'Noche' },
  { id: 'fuera', nombre: 'Fuera de casa' },
];
---

<div class="relative">
  <div id="casa3d" class="relative aspect-square w-full cursor-grab sm:aspect-[4/3.3] overflow-hidden rounded-[2rem] border border-borde bg-[#0b141b] active:cursor-grabbing">
    <!-- Respaldo si no hay WebGL o mientras carga -->
    <div id="casa3d-respaldo" class="absolute inset-0 grid place-items-center text-niebla">
      <Icono nombre="casa" class="size-24 opacity-40" />
    </div>
    <span id="casa3d-estado" class="absolute top-4 left-4 z-10 flex items-center gap-2 rounded-full bg-noche/70 px-3 py-1.5 text-xs font-medium text-niebla ring-1 ring-borde backdrop-blur transition-colors">
      <span class="pulso size-2 rounded-full bg-acento"></span> <span data-texto>Sistema conectado</span>
    </span>
    <span class="pointer-events-none absolute right-4 bottom-4 z-10 hidden text-[11px] text-niebla/70 sm:block">Arrastrá para girar</span>
  </div>

  <!-- Panel de control -->
  <div class="relative z-10 mx-auto -mt-10 w-[94%] rounded-3xl border border-borde bg-panel/90 p-2.5 shadow-2xl backdrop-blur-md sm:p-3">
    <div class="grid grid-cols-4 gap-2 sm:gap-3">
      {controles.map((c) => (
        <button
          type="button"
          data-control={c.id}
          aria-pressed={c.encendido ? 'true' : 'false'}
          class="group flex flex-col items-center gap-1.5 rounded-2xl px-1 py-3 text-niebla transition hover:bg-white/5 aria-pressed:bg-acento/10 aria-pressed:text-acento"
        >
          <Icono nombre={c.icono} class="size-6" />
          <span class="text-[11px] font-semibold sm:text-xs">{c.nombre}</span>
          <span class="h-1 w-6 rounded-full bg-borde transition group-aria-pressed:bg-acento"></span>
        </button>
      ))}
    </div>
    <div class="mt-2 flex items-center gap-2 border-t border-borde px-1 pt-2.5">
      <span class="hidden text-[10px] font-semibold tracking-[2px] text-niebla uppercase sm:inline">Escenas</span>
      <div class="grid flex-1 grid-cols-3 gap-2">
        {escenas.map((e) => (
          <button type="button" data-escena={e.id} class="rounded-xl border border-borde px-2 py-2 text-xs font-medium text-niebla transition hover:border-acento/60 hover:text-white">
            {e.nombre}
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import type { Estado } from '../scripts/casa3d';

  const contenedor = document.getElementById('casa3d')!;
  const indicador = document.getElementById('casa3d-estado')!;
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-control]');
  const reducirMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const estado: Estado = { luces: true, persianas: false, camaras: true, alarma: false, porton: false };
  botones.forEach((b) => ((estado as Record<string, boolean>)[b.dataset.control!] = b.getAttribute('aria-pressed') === 'true'));

  const ESCENAS: Record<string, Partial<Estado>> = {
    llegada: { luces: true, persianas: false, porton: true, alarma: false },
    noche: { luces: true, persianas: true, porton: false, alarma: true },
    fuera: { luces: false, persianas: true, porton: false, alarma: true, camaras: true },
  };

  let avisar = () => {};
  function sincronizarBotones() {
    botones.forEach((b) => b.setAttribute('aria-pressed', String((estado as Record<string, boolean>)[b.dataset.control!])));
    avisar();
  }

  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.control as keyof Estado;
      estado[id] = !estado[id];
      sincronizarBotones();
    })
  );
  document.querySelectorAll<HTMLButtonElement>('[data-escena]').forEach((b) =>
    b.addEventListener('click', () => {
      Object.assign(estado, ESCENAS[b.dataset.escena!]);
      sincronizarBotones();
    })
  );

  function alCambiarAlerta(intrusion: boolean) {
    indicador.querySelector('[data-texto]')!.textContent = intrusion ? 'Alarma disparada' : 'Sistema conectado';
    indicador.classList.toggle('text-[#ff3b5c]', intrusion);
    indicador.classList.toggle('ring-[#ff3b5c]/60', intrusion);
    indicador.querySelector('.pulso')!.classList.toggle('bg-[#ff3b5c]', intrusion);
  }

  function soportaWebGL() {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  }

  // three.js se descarga recién cuando la casa está por aparecer en pantalla
  if (soportaWebGL()) {
    const obs = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      const { iniciarCasa3D } = await import('../scripts/casa3d');
      const api = iniciarCasa3D({ contenedor, estado, reducirMovimiento, alCambiarAlerta });
      document.getElementById('casa3d-respaldo')?.remove();
      avisar = api.actualizar;
    }, { rootMargin: '200px' });
    obs.observe(contenedor);
  }
</script>
