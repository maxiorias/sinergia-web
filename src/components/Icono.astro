---
// Íconos de línea propios (sin librerías)
interface Props { nombre: string; class?: string }
const { nombre, class: clase = 'size-6' } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'casa' && (<><path d="M3 11 12 4l9 7" /><path d="M5 10v10h14V10" /><path d="M10 20v-5h4v5" /></>)}
  {nombre === 'camara' && (<><rect x="2" y="7" width="14" height="10" rx="2" /><path d="m16 11 6-3v8l-6-3" /></>)}
  {nombre === 'escudo' && (<><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></>)}
  {nombre === 'clima' && (<><path d="M12 3v10" /><circle cx="12" cy="17" r="4" /><path d="M16 5h3M16 8h3M16 11h2" /></>)}
  {nombre === 'audio' && (<><rect x="6" y="2" width="12" height="20" rx="2" /><circle cx="12" cy="14" r="3.5" /><circle cx="12" cy="6.5" r="1" /></>)}
  {nombre === 'porteria' && (<><rect x="5" y="2" width="14" height="20" rx="2" /><rect x="8" y="5" width="8" height="6" rx="1" /><circle cx="12" cy="16" r="1.5" /></>)}
  {nombre === 'wifi' && (<><path d="M2 9a15 15 0 0 1 20 0" /><path d="M5 12.5a10 10 0 0 1 14 0" /><path d="M8.5 16a5 5 0 0 1 7 0" /><circle cx="12" cy="19.5" r="1" /></>)}
  {nombre === 'candado' && (<><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /><circle cx="12" cy="16" r="1.3" /></>)}
  {nombre === 'luz' && (<><path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z" /></>)}
  {nombre === 'persiana' && (<><rect x="4" y="3" width="16" height="18" rx="1" /><path d="M4 7h16M4 11h16M4 15h16" /></>)}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nombre === 'mensaje' && (<><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z" /></>)}
  {nombre === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5v.01" /></>)}
  {nombre === 'ubicacion' && (<><path d="M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></>)}
</svg>
