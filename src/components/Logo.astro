---
// Logo de Sinergia Home redibujado en vector (techo + óvalo + nombre).
// Aproximación del original (sinergia.jfif): reemplazar por el vector oficial cuando lo tengamos.
interface Props { class?: string; tono?: 'azul' | 'blanco' }
const { class: clase = 'h-10 w-auto', tono = 'azul' } = Astro.props;
const color = tono === 'blanco' ? '#ffffff' : '#0000fe';
const texto = tono === 'blanco' ? '#ffffff' : '#0d1020';
const id = `ovalo-${tono}`;
---
<svg class={clase} viewBox="0 0 240 120" role="img" aria-label="Sinergia Home">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.25" stop-color={color} stop-opacity="0" />
      <stop offset="0.6" stop-color={color} stop-opacity="1" />
    </linearGradient>
  </defs>
  <ellipse cx="120" cy="74" rx="112" ry="38" fill="none" stroke={`url(#${id})`} stroke-width="5" />
  <path d="M74 64 113 22M127 22 166 64" stroke={color} stroke-width="11" stroke-linecap="butt" />
  <text x="120" y="83" text-anchor="middle" font-family="Outfit, sans-serif" font-size="30" font-weight="500" letter-spacing="-0.5" fill={texto}>sinergiahome</text>
</svg>
