---
import Layout from '../layouts/Layout.astro';
import Casa3D from '../components/Casa3D.astro';
import ArmaTuProyecto from '../components/ArmaTuProyecto.astro';
import Icono from '../components/Icono.astro';
import { servicios, casos, marcas, pasos, cobertura, preguntas, enlaceContacto } from '../data/sitio';

const antetitulo = 'text-xs font-semibold tracking-[4px] text-acento uppercase';
const h2 = 'mt-3 font-display text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl';
---

<Layout>
  <main>
    <!-- Hero con la casa 3D -->
    <section class="grilla relative overflow-hidden px-5 pt-32 pb-20 lg:pt-36">
      <div class="pointer-events-none absolute top-0 left-1/2 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-acento/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-borde bg-panel/70 px-3.5 py-1.5 text-xs text-niebla">
            <Icono nombre="ubicacion" class="size-3.5 text-acento" /> Trelew · Proyectos en toda la Patagonia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-bold tracking-tight sm:text-6xl">
            Tu casa, <span class="texto-acento">inteligente</span> y segura.
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-niebla">
            Domótica, cámaras con IA, alarmas, audio y redes. Diseñamos, instalamos y te acompañamos después.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={enlaceContacto('Hola Sinergia Home! Quiero pedir un presupuesto.')} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-2xl bg-acento px-6 py-3.5 font-semibold text-noche transition hover:brightness-110">
              Pedí tu presupuesto <Icono nombre="flecha" class="size-4" />
            </a>
            <a href="#proyecto" class="rounded-2xl border border-borde px-6 py-3.5 font-semibold transition hover:border-acento/60">Armá tu proyecto</a>
          </div>
          <p class="mt-8 text-sm text-niebla">Probá el panel: prendé las luces, bajá las persianas o activá la alarma.</p>
        </div>
        <Casa3D />
      </div>
    </section>

    <!-- Marcas -->
    <section class="border-y border-borde px-5 py-8">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-12 gap-y-4">
        <span class="text-xs tracking-[3px] text-niebla uppercase">Trabajamos con</span>
        {marcas.map((m) => <span class="font-display text-xl font-semibold text-white/70">{m}</span>)}
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-revelar>
          <p class={antetitulo}>Servicios</p>
          <h2 class={h2}>Todo lo que tu casa<br />o negocio necesita.</h2>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {servicios.map((s) => (
            <a href={`/servicios/${s.slug}`} class="group relative overflow-hidden rounded-3xl border border-borde bg-panel p-6 transition hover:-translate-y-1 hover:border-acento/50" data-revelar>
              <span class="grid size-12 place-items-center rounded-2xl bg-acento/10 text-acento ring-1 ring-acento/25 transition group-hover:bg-acento group-hover:text-noche">
                <Icono nombre={s.icono} />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold">{s.nombre}</h3>
              <p class="mt-2 text-sm leading-relaxed text-niebla">{s.resumen}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-acento">Ver más <Icono nombre="flecha" class="size-4 transition group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Obras -->
    <section id="obras" class="grilla border-y border-borde px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-revelar>
          <div>
            <p class={antetitulo}>Obras y novedades</p>
            <h2 class={h2}>Proyectos que<br />ya están funcionando.</h2>
          </div>
          <p class="max-w-sm text-niebla">Trelew, Playa Unión, Esquel, Bariloche: cada obra es distinta y la pensamos a medida.</p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2">
          {casos.map((c, i) => (
            <article class="relative overflow-hidden rounded-3xl border border-borde bg-panel p-8" data-revelar>
              {/* DEMO: acá van las fotos de cada obra */}
              <div class="relative mb-6 aspect-[16/7] overflow-hidden rounded-2xl border border-borde bg-[linear-gradient(135deg,#13303a,#0d1620)]">
                <div class="barrido absolute inset-x-0 h-1/3 bg-gradient-to-b from-transparent via-acento/15 to-transparent"></div>
                <span class="absolute bottom-3 left-3 rounded-lg bg-noche/70 px-2.5 py-1 text-[11px] text-niebla">Foto de la obra</span>
                <span class="absolute top-3 right-3 font-display text-5xl font-bold text-white/5">0{i + 1}</span>
              </div>
              <span class="rounded-full bg-acento/10 px-3 py-1 text-xs font-medium text-acento">{c.etiqueta}</span>
              <h3 class="mt-4 font-display text-2xl font-semibold">{c.titulo}</h3>
              <p class="mt-2 text-niebla">{c.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Cómo trabajamos -->
    <section class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-revelar>
          <p class={antetitulo}>Cómo trabajamos</p>
          <h2 class={h2}>De la idea a tu casa<br />funcionando.</h2>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-4">
          {pasos.map((p, i) => (
            <li class="relative rounded-3xl border border-borde bg-panel p-6" data-revelar>
              <span class="font-display text-sm text-acento">Paso {i + 1}</span>
              <h3 class="mt-3 font-display text-xl font-semibold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-niebla">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Arquitectos y desarrolladores -->
    <section id="arquitectos" class="px-5">
      <div class="relative mx-auto grid max-w-6xl gap-8 overflow-hidden rounded-[2rem] border border-acento/25 bg-[linear-gradient(135deg,#0f2a30,#0d141c_60%)] p-8 md:grid-cols-[1.3fr_1fr] md:items-center md:p-12" data-revelar>
        <div class="grilla pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
        <div class="relative">
          <p class={antetitulo}>Arquitectos y desarrolladores</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Pensemos la tecnología desde el plano.</h2>
          <p class="mt-4 text-niebla">Preinstalación, cableado estructurado, línea de teclas de diseño e integración de sistemas para que cada obra quede lista para el futuro.</p>
        </div>
        <div class="relative">
          <a href={enlaceContacto('Hola Sinergia Home! Quiero sumar tecnología a un proyecto de arquitectura.')} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-4 font-semibold text-noche transition hover:bg-acento">
            Hablemos de tu proyecto <Icono nombre="flecha" class="size-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- Armá tu proyecto -->
    <section id="proyecto" class="px-5 py-24">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div data-revelar>
          <p class={antetitulo}>Armá tu proyecto</p>
          <h2 class={h2}>Contanos qué<br />necesitás.</h2>
          <p class="mt-5 text-lg text-niebla">Elegí los servicios, el lugar y la zona. Armamos la consulta para que te respondamos con una propuesta concreta.</p>
          <ul class="mt-8 grid gap-3">
            {cobertura.map((c) => (
              <li class="flex items-center gap-3 rounded-2xl border border-borde bg-panel px-4 py-3">
                <Icono nombre="ubicacion" class="size-5 text-acento" />
                <span class="font-medium">{c.ciudad}</span>
                <span class="ml-auto text-sm text-niebla">{c.detalle}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-revelar><ArmaTuProyecto /></div>
      </div>
    </section>

    <!-- Preguntas -->
    <section class="border-t border-borde px-5 py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center" data-revelar>
          <p class={antetitulo}>Preguntas frecuentes</p>
          <h2 class={h2}>Lo que más nos consultan.</h2>
        </div>
        <div class="mt-10 space-y-3">
          {preguntas.map((p) => (
            <details class="group rounded-2xl border border-borde bg-panel px-6 py-5 open:border-acento/40">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium [&::-webkit-details-marker]:hidden">
                {p.pregunta}
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-acento/10 text-acento transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-niebla">{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
