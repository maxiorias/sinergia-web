---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import RedSinergia from '../components/RedSinergia.astro';
import ArmaTuProyecto from '../components/ArmaTuProyecto.astro';
import Icono from '../components/Icono.astro';
import { servicios, casos, marcas, pasos, cobertura, preguntas, enlaceContacto } from '../data/sitio';

const antetitulo = 'text-xs font-semibold tracking-[4px] text-marca uppercase';
const h2 = 'mt-3 font-display text-4xl leading-[1.05] font-semibold tracking-tight sm:text-5xl';
---

<Layout>
  <main>
    <!-- Hero en azul de marca con la animación de partículas -->
    <section class="relative overflow-hidden bg-[radial-gradient(ellipse_at_70%_40%,#1d22d9_0%,#0b0e8a_35%,#05072a_75%)] px-5 pt-32 pb-20 text-white lg:pt-36">
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs text-white/80 ring-1 ring-white/15">
            <Icono nombre="ubicacion" class="size-3.5" /> Trelew · Proyectos en toda la Patagonia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-semibold tracking-tight sm:text-6xl">
            Tecnología que trabaja en sinergia con tu casa.
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
            Domótica, cámaras con IA, alarmas, audio y redes. Diseñamos, instalamos y te acompañamos después.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={enlaceContacto('Hola Sinergia Home! Quiero pedir un presupuesto.')} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-2xl bg-white px-6 py-3.5 font-semibold text-marca transition hover:bg-azul-claro">
              Pedí tu presupuesto <Icono nombre="flecha" class="size-4" />
            </a>
            <a href="#obras" class="rounded-2xl px-6 py-3.5 font-semibold ring-1 ring-white/30 transition hover:bg-white/10">Ver obras</a>
          </div>
        </div>
        <RedSinergia />
      </div>
    </section>

    <!-- Marcas -->
    <section class="border-b border-linea px-5 py-8">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-12 gap-y-4">
        <span class="text-xs tracking-[3px] text-gris uppercase">Trabajamos con</span>
        {marcas.map((m) => <span class="font-display text-xl font-semibold text-tinta/60">{m}</span>)}
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-revelar>
          <p class={antetitulo}>Servicios</p>
          <h2 class={h2}>Todo lo que tu casa<br />o negocio necesita.</h2>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {servicios.map((s) => (
            <a href={`/servicios/${s.slug}`} class="group rounded-3xl border border-linea bg-white p-6 transition hover:-translate-y-1 hover:border-marca/40 hover:shadow-xl hover:shadow-marca/5" data-revelar>
              <span class="grid size-12 place-items-center rounded-2xl bg-azul-claro text-marca transition group-hover:bg-marca group-hover:text-white">
                <Icono nombre={s.icono} />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold">{s.nombre}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gris">{s.resumen}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-marca">Ver más <Icono nombre="flecha" class="size-4 transition group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Obras con fotos reales -->
    <section id="obras" class="bg-suave px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-revelar>
          <div>
            <p class={antetitulo}>Obras y novedades</p>
            <h2 class={h2}>Proyectos que<br />ya están funcionando.</h2>
          </div>
          <p class="max-w-sm text-gris">Trelew, Playa Unión, Esquel, Bariloche: cada obra es distinta y la pensamos a medida.</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {casos.map((c) => (
            <article class="group overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-linea" data-revelar>
              <div class="relative aspect-[16/10] overflow-hidden bg-noche">
                {c.foto ? (
                  <Image src={c.foto} alt={c.titulo} width={720} class="size-full object-cover transition duration-700 group-hover:scale-105" />
                ) : (
                  <div class="grid size-full place-items-center bg-[radial-gradient(circle_at_50%_40%,#1d22d9,#05072a_70%)] text-white/80">
                    <Icono nombre="camara" class="size-16" />
                  </div>
                )}
                <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-marca backdrop-blur">{c.etiqueta}</span>
              </div>
              <div class="p-7">
                <p class="text-xs font-semibold tracking-[3px] text-gris uppercase">{c.lugar}</p>
                <h3 class="mt-2 font-display text-2xl font-semibold">{c.titulo}</h3>
                <p class="mt-2 text-gris">{c.texto}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Cómo trabajamos -->
    <section class="px-5 py-24">
      <div class="mx-auto max-w-6xl">
        <div data-revelar>
          <p class={antetitulo}>Cómo trabajamos</p>
          <h2 class={h2}>De la idea a tu casa<br />funcionando.</h2>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-4">
          {pasos.map((p, i) => (
            <li class="rounded-3xl border border-linea p-6" data-revelar>
              <span class="grid size-10 place-items-center rounded-full bg-marca font-display font-semibold text-white">{i + 1}</span>
              <h3 class="mt-4 font-display text-xl font-semibold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gris">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Arquitectos y desarrolladores -->
    <section id="arquitectos" class="px-5">
      <div class="relative mx-auto grid max-w-6xl gap-8 overflow-hidden rounded-[2rem] bg-marca p-8 text-white md:grid-cols-[1.3fr_1fr] md:items-center md:p-12" data-revelar>
        <svg class="pointer-events-none absolute -right-16 -bottom-24 w-[30rem] opacity-15" viewBox="0 0 240 120" aria-hidden="true">
          <ellipse cx="120" cy="74" rx="112" ry="38" fill="none" stroke="#fff" stroke-width="4" />
          <path d="M74 64 113 22M127 22 166 64" stroke="#fff" stroke-width="10" />
        </svg>
        <div class="relative">
          <p class="text-xs font-semibold tracking-[4px] text-white/70 uppercase">Arquitectos y desarrolladores</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">Pensemos la tecnología desde el plano.</h2>
          <p class="mt-4 text-white/80">Preinstalación, cableado estructurado, línea de teclas de diseño e integración de sistemas para que cada obra quede lista para el futuro.</p>
        </div>
        <div class="relative">
          <a href={enlaceContacto('Hola Sinergia Home! Quiero sumar tecnología a un proyecto de arquitectura.')} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-4 font-semibold text-marca transition hover:bg-azul-claro">
            Hablemos de tu proyecto <Icono nombre="flecha" class="size-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- Armá tu proyecto -->
    <section id="proyecto" class="px-5 py-24">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div data-revelar>
          <p class={antetitulo}>Armá tu proyecto</p>
          <h2 class={h2}>Contanos qué<br />necesitás.</h2>
          <p class="mt-5 text-lg text-gris">Elegí los servicios, el lugar y la zona. Armamos la consulta para que te respondamos con una propuesta concreta.</p>
          <ul class="mt-8 grid gap-3">
            {cobertura.map((c) => (
              <li class="flex items-center gap-3 rounded-2xl border border-linea px-4 py-3">
                <Icono nombre="ubicacion" class="size-5 text-marca" />
                <span class="font-medium">{c.ciudad}</span>
                <span class="ml-auto text-sm text-gris">{c.detalle}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-revelar><ArmaTuProyecto /></div>
      </div>
    </section>

    <!-- Preguntas -->
    <section class="bg-suave px-5 py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center" data-revelar>
          <p class={antetitulo}>Preguntas frecuentes</p>
          <h2 class={h2}>Lo que más nos consultan.</h2>
        </div>
        <div class="mt-10 space-y-3">
          {preguntas.map((p) => (
            <details class="group rounded-2xl bg-white px-6 py-5 ring-1 ring-linea open:ring-marca/30">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium [&::-webkit-details-marker]:hidden">
                {p.pregunta}
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-azul-claro text-marca transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-gris">{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
