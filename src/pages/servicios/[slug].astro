---
// Una página por servicio: cada una apunta a una búsqueda local distinta (ej. "alarmas en Trelew")
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import { servicios, cobertura, enlaceContacto, type Servicio } from '../../data/sitio';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}
const { servicio } = Astro.props as { servicio: Servicio };
const otros = servicios.filter((s) => s.slug !== servicio.slug).slice(0, 4);
---

<Layout titulo={`${servicio.nombre} en Trelew y la Patagonia · Sinergia Home`} descripcion={`${servicio.descripcion} Trelew, Playa Unión, Esquel y Bariloche.`}>
  <main class="px-5 pt-36 pb-24">
    <div class="mx-auto max-w-6xl">
      <a href="/#servicios" class="text-sm text-gris hover:text-marca">← Todos los servicios</a>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <span class="grid size-16 place-items-center rounded-2xl bg-azul-claro text-marca"><Icono nombre={servicio.icono} class="size-8" /></span>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight">{servicio.nombre}</h1>
          <p class="mt-5 text-xl leading-relaxed text-gris">{servicio.descripcion}</p>
          <h2 class="mt-10 font-display text-xl font-semibold">Qué incluye</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {servicio.incluye.map((i) => (
              <li class="flex items-start gap-3 rounded-2xl border border-linea bg-white p-4">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-marca"></span> {i}
              </li>
            ))}
          </ul>
          <p class="mt-8 text-gris"><strong class="text-tinta">Ideal para:</strong> {servicio.ideal}</p>
          {servicio.foto && (
            <figure class="mt-10 overflow-hidden rounded-3xl">
              <Image src={servicio.foto} alt={`${servicio.nombre}: obra de Sinergia Home`} width={760} class="aspect-[16/10] w-full object-cover" />
              <figcaption class="mt-2 text-xs text-gris">Obra real de Sinergia Home</figcaption>
            </figure>
          )}
        </div>
        <aside class="h-fit rounded-[2rem] border border-linea bg-white p-8 lg:sticky lg:top-28">
          <h2 class="font-display text-2xl font-semibold">¿Lo querés en tu casa o negocio?</h2>
          <p class="mt-3 text-gris">Coordinamos un relevamiento y te pasamos una propuesta.</p>
          <a href={enlaceContacto(`Hola Sinergia Home! Me interesa ${servicio.nombre.toLowerCase()}.`)} target="_blank" rel="noopener" class="mt-6 flex items-center justify-center gap-2 rounded-2xl bg-marca px-6 py-4 font-semibold text-white transition hover:bg-azul">
            Pedí tu presupuesto <Icono nombre="flecha" class="size-4" />
          </a>
          <p class="mt-6 text-xs tracking-[3px] text-gris uppercase">Zonas</p>
          <p class="mt-2 text-sm text-gris">{cobertura.map((c) => c.ciudad).join(' · ')}</p>
        </aside>
      </div>

      <h2 class="mt-20 font-display text-2xl font-semibold">Otros servicios</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {otros.map((s) => (
          <a href={`/servicios/${s.slug}`} class="rounded-3xl border border-linea bg-white p-5 transition hover:border-marca/40">
            <Icono nombre={s.icono} class="size-6 text-marca" />
            <p class="mt-3 font-display font-semibold">{s.nombre}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
